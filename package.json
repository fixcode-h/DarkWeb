{
  "name": "darkweb",
  "version": "0.8.3",
  "private": true,
  "description": "Drak：通用自适应暗色模式浏览器插件（Chrome / Edge MV3）",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:release": "node scripts/build.mjs --zip",
    "store:publish": "node scripts/cws-publish.mjs",
    "store:assets": "node scripts/build.mjs && node scripts/store-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/build.mjs --store && node test/e2e/run.mjs && node test/e2e/translate.mjs && node test/e2e/enhance.mjs && node test/e2e/markdown.mjs && node test/e2e/update.mjs && node test/e2e/ghaccel.mjs && node test/e2e/sniff.mjs",
    "check": "npm run typecheck && npm run test && npm run test:e2e"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "@mozilla/readability": "^0.6.0",
    "@types/chrome": "0.0.287",
    "@types/markdown-it": "^14.2.0",
    "@types/markdown-it-footnote": "^3.0.4",
    "esbuild": "0.24.2",
    "highlight.js": "^11.12.0",
    "markdown-it": "^14.3.3",
    "markdown-it-footnote": "^4.0.0",
    "mermaid": "^12.3.0",
    "mux.js": "^6.3.0",
    "playwright": "1.63.0",
    "tldts": "7.4.22",
    "typescript": "5.7.3",
    "vitest": "2.1.9"
  }
}
