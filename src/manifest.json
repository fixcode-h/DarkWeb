{
  "manifest_version": 3,
  "name": "Drak 暗色模式",
  "short_name": "Drak",
  "description": "自适应暗色模式：按颜色角色重新配色，保留边框与层次，不做简单反色。",
  "version": "0.0.0",
  "key": "",
  "minimum_chrome_version": "120",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "background": { "service_worker": "sw.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Drak 暗色模式", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "options_page": "options.html",
  "permissions": ["storage", "unlimitedStorage", "scripting", "alarms", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "toggle-site": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "开关当前网站的暗色模式"
    },
    "toggle-global": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "全局开关暗色模式"
    },
    "toggle-translate": {
      "suggested_key": { "default": "Alt+Shift+T" },
      "description": "翻译当前页面 / 显示原文"
    }
  }
}
